# Copy this file to .env.local and fill in real values for local dev.
# In production (Vercel), set these as environment variables in the project
# settings instead of committing a .env file.

# Postgres connection string. A local Postgres for dev, your Neon
# connection string in production. Standard "pg" wire-protocol URL --
# Neon's dashboard gives you one of these directly (not just the HTTP one).
DATABASE_URL=postgres://user:password@localhost:5432/blinds_dev

# Secret used to sign/encrypt session cookies (Auth.js). Generate one with:
#   npx auth secret
# or: openssl rand -base64 33
# Must be set to a real random value in production -- the dev-only example
# used while building this was NOT a secure value, don't reuse it.
AUTH_SECRET=replace-with-a-real-random-secret
